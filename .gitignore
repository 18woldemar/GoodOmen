# Game assets and binaries NEVER enter this repository.
#
# Directory patterns are anchored with a leading slash on purpose: without
# one git matches them at ANY depth, and an unanchored `game/` silently
# swallowed the whole of `engine/src/game/` -- eight source files that were
# never committed and would have made a published checkout not compile.
*.exe
*.dll
*.mdl
*.pak
*.lvl
*.wav
*.mp3
*.dds
*.tga
*.bik
*.smk
/game/
/gamedata/
/extracted/
/prefixes/
/testdata/*
!/testdata/*.json
!/testdata/README.md

# Local paths to the Wine prefixes
.env.local

# Traces and dumps
*.log
*.trace
*.bin
/dumps/

# Ghidra
*.gpr
*.rep/
/ghidra_projects/

# Python
__pycache__/
*.pyc
/.venv/

# unpacked assets
/extracted/
*.tex
*.mod
*.bsp
*.omn
*.sta
*.str
*.ifr
*.mus
*.acm

# derived assets
/png/

# reference decoder needs unicorn
/.venv/

# generated viewers embed assets
/view/

# the engine's build output
engine/target/

# Instructions and notes for AI coding agents. They are working files, not
# part of the project: they describe how to drive the work, not what the work
# found. What is worth keeping from them lives in docs/rules.md and
# docs/journal.md instead.
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md
